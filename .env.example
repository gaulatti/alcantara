# Copy to .env (same directory as compose.yml) or set as shell env vars.
# Docker Compose reads this file for variable interpolation in compose.yml.

# Backend server port (also set in backend/.env as PORT)
BACKEND_PORT=3000

# Frontend dev server port (also set in frontend/.env as VITE_PORT)
VITE_PORT=5173

# Local LiveKit ports are fixed by the supported Compose workflow.
# Production WebSocket and credentials are backend-owned configuration.
LIVEKIT_SIGNAL_PORT=7880
