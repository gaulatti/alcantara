FROM node:22.23.5-alpine

ARG ALCANTARA_BUILD_VERSION=dev
ENV ALCANTARA_BUILD_VERSION=${ALCANTARA_BUILD_VERSION}

RUN apk add --no-cache postgresql17-client ffmpeg \
    && pg_dump --version | grep -Eq ' 17\.'
RUN npm install -g pnpm@9

WORKDIR /app

# Install exactly the workspace lockfile's versions, as the production image does (gaulatti/alcantara#590,
# #581). The build context is the repository root; a lockfile out of step with a package.json fails the
# build. Only the backend's dependencies are installed. The backend lives at /app/backend.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json backend/
COPY frontend/package.json frontend/
COPY infra/aws/package.json infra/aws/
COPY e2e/package.json e2e/
RUN pnpm install --frozen-lockfile --ignore-scripts --filter backend

WORKDIR /app/backend
COPY backend/prisma ./prisma
RUN pnpm prisma:generate

COPY backend/ ./

CMD ["pnpm", "start:dev"]
