// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Layout {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  componentType String
  settings      String // JSON stringified
  teamId        Int?
  scenes        Scene[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([teamId])
}

model Scene {
  id            Int            @id @default(autoincrement())
  name          String
  layoutId      Int
  layout        Layout         @relation(fields: [layoutId], references: [id])
  chyronText    String?
  metadata      String? // JSON stringified
  teamId        Int?
  programStates ProgramState[]
  programScenes ProgramScene[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  externalSourceId String?
  externalSource ExternalSource? @relation(fields: [externalSourceId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([externalSourceId])
}

model Program {
  programId String   @id
  teamId    Int?
  channelId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branding  ProgramBranding?

  @@index([teamId])
}

// gaulatti/alcantara#335: per-program station marks, one row per Program. Owned through the Program
// row (which carries the team), and written through the program.manage permission.
model ProgramBranding {
  programId     String   @id
  program       Program  @relation(fields: [programId], references: [programId], onDelete: Cascade)
  displayName   String?
  callsign      String?
  subtitle      String?
  logoUrl       String?
  hashtag       String?
  siteUrl       String?
  defaultChyron String?
  updatedAt     DateTime     @updatedAt
}

model ProgramState {
  id                     Int                  @id @default(autoincrement())
  programId              String               @unique
  type                   String               @default("tv")
  templateUrl            String?
  templateManifest       Json?
  templateVerifiedAt     DateTime?
  activeSceneId          Int?
  activeScene            Scene?               @relation(fields: [activeSceneId], references: [id])
  stagedSceneId          Int?
  fadeToBlack            Boolean              @default(false)
  songSequence           Json?
  songQueue              Json?
  songRotation           Json?
  songArtistCycle        Json?
  shuffleOrder           Json?
  audioMixer             Json?
  activeFlightSequenceId Int?
  flightSequences        FlightSequence[]
  scenes                 ProgramScene[]
  mediaGroups            ProgramMediaGroup[]
  stingers               ProgramStinger[]
  radioSettings          RadioSettings?
  nowPlayingConsumers    NowPlayingConsumer[]
  songIntros             SongIntro[]
  broadcastSelections    BroadcastDestinationSelection[]
  broadcastCommands      BroadcastDestinationCommand[]
  externalSourceAssignments ExternalSourceProgram[]
  rundownRecipes         RundownRecipe[]
  updatedAt              DateTime             @updatedAt
}

model BroadcastDestination {
  id              String   @id
  teamId          Int?
  displayName     String
  secretId        String
  secretVersionId String
  position        Int
  /// gaulatti/alcantara#376: how the destination was added ('youtube' or 'custom'; null for a
  /// row whose secret reference was typed by hand), its non-secret ingest address, the last four
  /// characters of the key (never more) and when the key was last set.
  service         String?
  ingestUrl       String?
  keyLast4        String?
  keySetAt        DateTime?
  retiredAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([teamId])
  @@index([retiredAt, position])
}

/// One row per destination created or key replaced through the console (gaulatti/alcantara#376).
/// Audit only: who, which destination, what, when. The key is never stored here.
model BroadcastDestinationKeyChange {
  id            String   @id @default(uuid())
  teamId        Int?
  destinationId String
  subject       String
  action        String
  createdAt     DateTime @default(now())

  @@index([teamId])
  @@index([destinationId, createdAt])
}

/// An operator change to on-air settings, written in the same transaction as the change (gaulatti/alcantara#236).
/// The summary holds field names and allowlisted values only: never a URL, key or other secret.
model OperatorChangeRecord {
  id         String   @id @default(uuid())
  teamId     Int?
  programId  String
  principal  String?
  via        String
  client     String?
  capability String
  summary    Json
  createdAt  DateTime @default(now())

  @@index([teamId])
  @@index([programId, createdAt])
}

model BroadcastDestinationSelection {
  id               String                                @id @default(uuid())
  version          String                                @unique
  programId        String
  program          ProgramState                          @relation(fields: [programId], references: [programId], onDelete: Restrict)
  selectionHash    String
  createdBySubject String
  createdAt        DateTime                              @default(now())
  destinations     BroadcastDestinationSelectionItem[]
  commands         BroadcastDestinationCommand[]

  @@index([programId, createdAt])
}

model BroadcastDestinationSelectionItem {
  id               String                        @id @default(uuid())
  selectionId      String
  selection        BroadcastDestinationSelection @relation(fields: [selectionId], references: [id], onDelete: Restrict)
  destinationId    String
  displayName      String
  secretId         String
  secretVersionId  String
  position         Int

  @@unique([selectionId, destinationId])
  @@index([selectionId, position])
}

model BroadcastDestinationCommand {
  id               String                         @id
  programId        String
  program          ProgramState                   @relation(fields: [programId], references: [programId], onDelete: Restrict)
  action           String
  requestHash      String
  sequence         Int
  selectionId      String?
  selection        BroadcastDestinationSelection? @relation(fields: [selectionId], references: [id], onDelete: Restrict)
  actorSubject     String
  status           String
  downstreamStatus Json?
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  @@unique([programId, sequence])
  @@index([programId, createdAt])
  @@index([selectionId])
}

/// One row per request for a destination's ingest credential (gaulatti/carmencita#4). Audit only:
/// who asked, for which destination, when, and the outcome. The credential itself is never stored.
model BroadcastIngestAccess {
  id            String   @id @default(uuid())
  /// The destination's team (null when the destination id is unknown).
  teamId        Int?
  destinationId String
  subject       String
  outcome       String
  createdAt     DateTime @default(now())

  @@index([teamId])
  @@index([destinationId, createdAt])
  @@index([subject, createdAt])
}

model BroadcastDestinationRuntime {
  programId          String   @id
  nextSequence       Int      @default(1)
  requestedState     String   @default("stopped")
  actualState        String   @default("unknown")
  pendingSelectionId String?
  activeSelectionId  String?
  updatedAt          DateTime @updatedAt
}

/// One immutable filler configuration for one program leg (gaulatti/alcantara#126).
/// Only safe identity is stored: source asset ids and SHA-256, mode, seed and
/// the acknowledged profile checksum. Never download URLs or credentials.
model FillerVersion {
  id         String    @id
  programId  String
  leg        String
  checksum   String
  config     Json
  status     String    @default("preparing")
  reason     String?
  createdBy  String
  createdAt  DateTime  @default(now())
  preparedAt DateTime?

  @@index([programId, leg, createdAt])
}

/// The prepared next-session (pending) and in-session (active) filler
/// versions of one program leg.
model FillerLeg {
  programId        String
  leg              String
  pendingVersionId String?
  activeVersionId  String?
  updatedAt        DateTime @updatedAt

  @@id([programId, leg])
}

model ExternalSource {
  id                        String                  @id @default(uuid())
  teamId                    Int
  name                      String
  transport                 String
  lifecycle                 String                  @default("unconfigured")
  health                    String                  @default("unknown")
  normalizationProfile      String                  @default("720p30")
  transportConfigCiphertext String
  transportConfigNonce      String
  configKeyVersion          Int
  credentialVersion         Int                     @default(0)
  ingressId                 String?
  participantIdentity       String?
  lastConnectedAt           DateTime?
  revokedAt                 DateTime?
  createdBySubject          String
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  programs                  ExternalSourceProgram[]
  credentials               ExternalSourceCredential[]
  scenes                    Scene[]

  @@index([teamId, lifecycle])
  @@index([transport, health])
}

model ExternalSourceProgram {
  sourceId  String
  programId String
  source    ExternalSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  program   ProgramState   @relation(fields: [programId], references: [programId], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@id([sourceId, programId])
  @@index([programId])
}

model ExternalSourceCredential {
  id         String         @id @default(uuid())
  sourceId   String
  source     ExternalSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  version    Int
  secretHash String
  revokedAt  DateTime?
  createdAt  DateTime       @default(now())

  @@unique([sourceId, version])
  @@index([sourceId, revokedAt])
}

model FlightSequence {
  id             Int          @id @default(autoincrement())
  programStateId Int
  programState   ProgramState @relation(fields: [programStateId], references: [id], onDelete: Cascade)
  name           String
  items          Json
  loop           Boolean      @default(false)
  isRunning      Boolean      @default(false)
  activeItemId   String?
  scheduledAt    DateTime?
  publishedAt    DateTime?
  revision       Int          @default(1)
  lastStartedAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([programStateId, name])
  @@unique([programStateId, scheduledAt])
}

/// gaulatti/alcantara#424 (#222 R3): a named rundown recipe of one program. A use of it is
/// written into a rundown as ordinary cues tagged with the recipe's id and revision; the
/// scenes are ones assigned to the program, and `steps` lists the enabled steps.
model RundownRecipe {
  id               Int          @id @default(autoincrement())
  programStateId   Int
  programState     ProgramState @relation(fields: [programStateId], references: [id], onDelete: Cascade)
  name             String
  revision         Int          @default(1)
  bumperSceneId    Int?
  slideshowSceneId Int?
  returnSceneId    Int?
  transitionId     String       @default("cut")
  holdMs           Int          @default(3000)
  steps            Json
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([programStateId, name])
}

model ProgramScene {
  id             Int          @id @default(autoincrement())
  programStateId Int
  sceneId        Int
  position       Int
  programState   ProgramState @relation(fields: [programStateId], references: [id], onDelete: Cascade)
  scene          Scene        @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@unique([programStateId, sceneId])
  @@unique([programStateId, position])
}

model BroadcastSettings {
  id                    Int       @id
  teamId                Int?
  timeOverrideEnabled   Boolean   @default(false)
  timeOverrideStartTime String?
  timeOverrideStartedAt DateTime?
  mixerChannels         Json?
  mainMasterVolume      Float     @default(1)
  songMasterVolume      Float     @default(1)
  instantMasterVolume   Float     @default(1)
  streamMasterVolume    Float     @default(1)
  songMuted             Boolean   @default(false)
  instantMuted          Boolean   @default(false)
  streamMuted           Boolean   @default(false)
  songSolo              Boolean   @default(false)
  instantSolo           Boolean   @default(false)
  streamSolo            Boolean   @default(false)
  updatedAt             DateTime  @updatedAt

  @@index([teamId])
}

enum MediaAssetKind {
  IMAGE
  AUDIO_CLIP
  SONG
  TRANSITION
}

enum MediaAssetType {
  IMAGE
  AUDIO
  VIDEO
}

model MediaAsset {
  id              String                     @id
  teamId          Int?
  kind            MediaAssetKind?
  mediaType       MediaAssetType?
  name            String
  sourceUrl       String
  enabled         Boolean                    @default(true)
  image           Media?                     @relation("ImageMediaAsset")
  audioClip       Instant?                   @relation("AudioClipMediaAsset")
  backgroundAudio BackgroundAudioCapability?
  song            Song?                      @relation("SongMediaAsset")
  songCovers      Song[]                     @relation("SongCoverMediaAsset")
  transition      Stinger?                   @relation("TransitionMediaAsset")
  analysis        MediaAssetAnalysis?
  labels          MediaAssetLabel[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([teamId])
  @@index([kind, updatedAt])
  @@index([mediaType, updatedAt])
}

model BackgroundAudioCapability {
  assetId       String     @id
  asset         MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  defaultVolume Float      @default(1)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model MediaLabel {
  id          String            @id @default(uuid())
  name        String            @unique
  teamId      Int?
  description String?
  assets      MediaAssetLabel[]
  artists     ArtistLabel[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([teamId])
}

/// The media label whose pictures stand for an artist (gaulatti/alcantara#423). Keyed on the same
/// normalised text artist separation, as-run and charts use, so there is no second notion of artist.
model ArtistLabel {
  id        Int        @id @default(autoincrement())
  artistKey String
  teamId    Int?
  /// The artist as last saved, for display; the key is what matches.
  artist    String
  labelId   String
  label     MediaLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)
  updatedAt DateTime   @updatedAt

  @@unique([teamId, artistKey])
  @@index([labelId])
}

model MediaAssetLabel {
  labelId   String
  assetId   String
  position  Int
  label     MediaLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([labelId, assetId])
  @@unique([labelId, position])
  @@index([assetId])
}

model Instant {
  id        Int      @id @default(autoincrement())
  assetId   String?  @unique
  asset     MediaAsset? @relation("AudioClipMediaAsset", fields: [assetId], references: [id], onDelete: SetNull)
  name      String
  teamId    Int?
  audioUrl  String
  volume    Float    @default(1)
  enabled   Boolean  @default(true)
  position  Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  songIntro SongIntro?

  @@index([teamId])
}

model Song {
  id           Int      @id @default(autoincrement())
  assetId      String?  @unique
  asset        MediaAsset? @relation("SongMediaAsset", fields: [assetId], references: [id], onDelete: SetNull)
  coverAssetId String?
  coverAsset   MediaAsset? @relation("SongCoverMediaAsset", fields: [coverAssetId], references: [id], onDelete: SetNull)
  artist       String
  title        String
  teamId       Int?
  audioUrl     String
  coverUrl     String?
  durationMs   Int?
  earoneSongId String?
  earoneRank   String?
  earoneSpins  String?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  intro        SongIntro?
  embeddings   SongEmbedding[]
  chartIdentity SongChartIdentity?

  @@index([teamId])
  @@index([coverAssetId])
}

model SongChartIdentity {
  id         Int      @id @default(autoincrement())
  songId     Int      @unique
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  provider   String
  externalId String?
  rank       String?
  spins      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Audio embedding of a song's opening or closing window. The vector column is
/// pgvector's dimensionless `vector` type so another model can be stored later;
/// it is read and written with raw SQL because Prisma cannot model it.
model SongEmbedding {
  id            Int      @id @default(autoincrement())
  songId        Int
  song          Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  segment       String
  model         String
  modelVersion  String
  license       String
  windowSeconds Int
  audioSha256   String
  vector        Unsupported("vector")
  computedAt    DateTime
  createdAt     DateTime @default(now())

  @@unique([songId, segment, model, windowSeconds])
  @@index([model, windowSeconds])
}

/// Shadow/on-air record of what the similarity picker proposed at a song change.
model SimilarityDecision {
  id             Int      @id @default(autoincrement())
  programId      String
  mode           String
  outcome        String
  currentSongId  Int?
  proposedSongId Int?
  playedSongId   Int?
  score          Float?
  runnerUps      Json
  createdAt      DateTime @default(now())

  @@index([programId, createdAt])
}

model SongIntro {
  id        Int          @id @default(autoincrement())
  songId    Int          @unique
  instantId Int          @unique
  programId String
  song      Song         @relation(fields: [songId], references: [id], onDelete: Cascade)
  instant   Instant      @relation(fields: [instantId], references: [id], onDelete: Restrict)
  program   ProgramState @relation(fields: [programId], references: [programId], onDelete: Restrict)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([programId])
}

model Media {
  id         Int              @id @default(autoincrement())
  assetId    String?          @unique
  asset      MediaAsset?      @relation("ImageMediaAsset", fields: [assetId], references: [id], onDelete: SetNull)
  name       String
  teamId     Int?
  imageUrl   String
  groupItems MediaGroupItem[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([teamId])
}

model MediaGroup {
  id                 Int                 @id @default(autoincrement())
  name               String              @unique
  teamId             Int?
  description        String?
  mediaItems         MediaGroupItem[]
  programMediaGroups ProgramMediaGroup[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([teamId])
}

model MediaGroupItem {
  id           Int        @id @default(autoincrement())
  mediaGroupId Int
  mediaId      Int
  position     Int
  mediaGroup   MediaGroup @relation(fields: [mediaGroupId], references: [id], onDelete: Cascade)
  media        Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaGroupId, mediaId])
  @@unique([mediaGroupId, position])
}

model ProgramMediaGroup {
  id             Int          @id @default(autoincrement())
  programStateId Int
  mediaGroupId   Int
  position       Int
  programState   ProgramState @relation(fields: [programStateId], references: [id], onDelete: Cascade)
  mediaGroup     MediaGroup   @relation(fields: [mediaGroupId], references: [id], onDelete: Cascade)

  @@unique([programStateId, mediaGroupId])
  @@unique([programStateId, position])
}

model Stinger {
  id              Int              @id @default(autoincrement())
  assetId         String?          @unique
  asset           MediaAsset?      @relation("TransitionMediaAsset", fields: [assetId], references: [id], onDelete: SetNull)
  name            String
  teamId          Int?
  videoUrl        String
  cutPointMs      Int              @default(1000)
  enabled         Boolean          @default(true)
  programStingers ProgramStinger[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([teamId])
}

model ProgramStinger {
  id             Int          @id @default(autoincrement())
  programStateId Int
  stingerId      Int
  position       Int
  programState   ProgramState @relation(fields: [programStateId], references: [id], onDelete: Cascade)
  stinger        Stinger      @relation(fields: [stingerId], references: [id], onDelete: Cascade)

  @@unique([programStateId, stingerId])
  @@unique([programStateId, position])
}

model RadioSettings {
  id               Int          @id @default(autoincrement())
  programStateId   Int          @unique
  programState     ProgramState @relation(fields: [programStateId], references: [id], onDelete: Cascade)
  palazzoUrl       String       @default("http://palazzo:3100")
  listenerUrl      String?
  bumperEnabled    Boolean      @default(true)
  bumperInterval   Int?
  bumperInstantIds Int[]        @default([])
  bumperMode       String       @default("sequential")
  fillerSongIds    Int[]        @default([])
  fillerVersion    String?
  enabled          Boolean      @default(false)
  segueMode        String       @default("on")
  /// segueMode before #180 turned it on for existing programs; null when it was already on. Kept for a put-back.
  segueModeBeforeDefaultOn String?
  similarityMode          String @default("on")
  similarityThreshold     Float  @default(0.8)
  similarityWindowSeconds Int    @default(30)
  similarityPool          String @default("sequence")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model NowPlayingConsumer {
  id             Int          @id @default(autoincrement())
  programStateId Int
  programState   ProgramState @relation(fields: [programStateId], references: [id], onDelete: Cascade)
  name           String
  url            String
  method         String       @default("POST")
  headers        Json?
  enabled        Boolean      @default(true)
  position       Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([programStateId, name])
  @@unique([programStateId, position])
}

model OperatorPreference {
  subject     String
  // Canonical Pompeii principal, once resolved. Nullable and additive: the
  // primary key stays on the pool subject so no existing row moves, and reads
  // resolve by principal first with a subject fallback.
  principalId String?
  deviceClass String
  version     Int      @default(1)
  profile     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([subject, deviceClass])
  @@index([subject])
  @@index([principalId, deviceClass])
}

model SharedConsoleLayout {
  id                String    @id @default(uuid())
  ownerSubject      String
  /// Canonical Pompeii principal for the owner, once resolved. Ownership
  /// matches this when present and falls back to ownerSubject when absent.
  ownerPrincipalId  String?
  name              String
  description       String?
  scope             String
  scopeId           String
  sourceDeviceClass String
  version           Int       @default(1)
  profile           Json
  retiredAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([scope, scopeId, name])
  @@index([scope, scopeId, retiredAt])
  @@index([ownerSubject])
  @@index([ownerPrincipalId])
}

model GuestInvitation {
  id                 String         @id @default(uuid())
  tokenHash          String         @unique
  programId          String
  displayName        String
  slotNumber         Int?
  returnVideo        String         @default("program")
  returnAudioBus     String         @default("master")
  sourceGain         Float          @default(1)
  sourceMuted        Boolean        @default(false)
  sourceDelayMs      Int            @default(0)
  expiresAt          DateTime
  revokedAt          DateTime?
  activeSessionId    String?
  activeSessionUntil DateTime?
  createdByIdentity  String
  /// Canonical Pompeii principal of the operator who created this invitation.
  /// Audit only. createdByIdentity is never rewritten, so historical actor
  /// display survives even when no verified mapping exists.
  createdByPrincipalId String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  commands           GuestCommand[]
  events             GuestEvent[]

  @@index([programId, expiresAt])
  @@unique([programId, slotNumber])
}

model GuestCommand {
  id             String          @id @default(uuid())
  invitationId   String
  invitation     GuestInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  type           String
  payload        Json
  status         String          @default("requested")
  failureReason  String?
  createdAt      DateTime        @default(now())
  deliveredAt    DateTime?
  acknowledgedAt DateTime?

  @@index([invitationId, createdAt])
}



model GuestEvent {
  id           String          @id @default(uuid())
  invitationId String
  invitation   GuestInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  type         String
  details      Json?
  createdAt    DateTime        @default(now())

  @@index([invitationId, createdAt])
}

model MediaAssetAnalysis {
  assetId                String     @id
  asset                  MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  status                 String     @default("pending")
  cueInSeconds           Float?
  cueOutSeconds          Float?
  fadeInSeconds          Float?
  fadeOutSeconds         Float?
  overlapSeconds         Float?
  integratedLufs         Float?
  truePeakDbtp           Float?
  /// The decoded length of the file, from the same pass that measures the cue points; null until measured.
  durationSeconds        Float?
  isrc                   String?
  musicbrainzRecordingId String?
  error                  String?
  /// Analysis runs claimed for the current source, bounded by the analysis job.
  attempts               Int        @default(0)
  /// When a claimed run's lease ends or a failed run may be retried; null when settled.
  nextAttemptAt          DateTime?
  /// The source URL the row describes; a different MediaAsset.sourceUrl means the row is stale.
  sourceUrl              String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
}

/// As-run record of track playback events on a radio program.
/// Records reference songs and assets by scalar id with no foreign key relation,
/// so deleting a song or asset preserves historical playback audit trails.
model AsRunRecord {
  id        Int      @id @default(autoincrement())
  programId String
  songId    Int?
  assetId   String?
  state     String
  at        DateTime
  createdAt DateTime @default(now())
  /// Engine playback request ID; at most one record per play and state.
  playbackRequestId String?
  /// True on an end the engine inferred because the real end never arrived.
  inferred          Boolean @default(false)
  /// Review flag on an inferred end: `short` or `no-start`; null otherwise.
  reviewFlag        String?
  /// Why the engine ended a started play: `stopped`, `replaced` or `superseded`; null otherwise.
  endReason         String?
  /// Who caused an operator action: Pompeii principal (null while unresolved or for automatic transitions).
  actorPrincipalId  String?
  /// `console` or `mcp`; null for automatic transitions and older rows.
  actorVia          String?
  /// MCP client name when `actorVia` is `mcp`; null otherwise.
  actorClient       String?

  @@unique([programId, playbackRequestId, state])
  @@index([programId, at])
}

